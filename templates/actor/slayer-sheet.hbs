<div class="nas-app">
  <aside class="nas-identity" aria-label="Identidade do personagem">
    <header class="nas-identity-head">
      <label class="nas-level">
        <span>Nível</span>
        <input type="number" min="1" name="system.level" value="{{system.level}}" aria-label="Nível" {{#unless editable}}disabled{{/unless}}>
      </label>
      <div class="nas-name">
        <input class="nas-name-input" name="name" value="{{actor.name}}" aria-label="Nome do personagem" {{#unless editable}}disabled{{/unless}}>
        <span class="nas-name-sub">{{identityLine}}</span>
      </div>
    </header>
    <figure class="nas-portrait">
      <img src="{{actor.img}}" alt="Retrato de {{actor.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
      {{#if editable}}<figcaption class="nas-portrait-label" aria-hidden="true"><i class="fa-solid fa-image"></i> Alterar retrato</figcaption>{{/if}}
    </figure>
  </aside>

  <div class="nas-workspace">
    <header class="nas-topbar">
      <div class="nas-resources" aria-label="Recursos do personagem">
        {{#each resources}}
          <div class="nas-resource nas-resource-{{className}}">
            <i class="fa-solid {{icon}} nas-resource-icon" aria-hidden="true"></i>
            <span class="nas-resource-label">{{name}}</span>
            <div class="nas-resource-track" role="progressbar" aria-label="{{name}}" aria-valuemin="0" aria-valuemax="{{max}}" aria-valuenow="{{value}}"><div class="nas-resource-fill" style="width:{{percent}}%"></div></div>
            <span class="nas-resource-values">
              <input aria-label="{{name}} atual" type="number" min="0" name="system.resources.{{id}}.value" value="{{value}}" {{#unless ../editable}}disabled{{/unless}}>
              <span aria-hidden="true">/</span>
              <input aria-label="{{name}} máximo" type="number" min="0" name="system.resources.{{id}}.max" value="{{max}}" {{#unless ../editable}}disabled{{/unless}}>
            </span>
          </div>
        {{/each}}
      </div>
      <div class="nas-section-badge">
        <span class="nas-emblem"><i class="fa-solid {{currentTab.icon}}" aria-hidden="true"></i></span>
        <div><h2>{{currentTab.name}}</h2><span>{{currentTab.subtitle}}</span></div>
      </div>
    </header>

    <main class="nas-main">
      {{#if tabs.personagem}}
        <section class="nas-panel">
          <h3 class="nas-panel-title"><i class="fa-solid fa-khanda" aria-hidden="true"></i> Atributos base</h3>
          <div class="nas-attribute-rail" tabindex="0" aria-label="Sete atributos do personagem">
            {{#each attributes}}
              <div class="nas-attribute" style="--nas-accent:{{color}}">
                <label for="nas-{{id}}-{{../actor.id}}">{{name}}</label>
                <input id="nas-{{id}}-{{../actor.id}}" type="number" min="0" name="system.attributes.{{id}}" value="{{value}}" {{#unless ../editable}}disabled{{/unless}}>
                <button type="button" class="nas-die" data-action="attribute" data-attribute="{{id}}" aria-label="Testar {{name}}" data-tooltip="Testar {{name}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i></button>
              </div>
            {{/each}}
          </div>
        </section>
        <div class="nas-grid nas-grid-2">
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-user-ninja" aria-hidden="true"></i> Persona</h3>
            <div class="nas-fields">
              <label>Classe
                <select name="system.classId" {{#unless editable}}disabled{{/unless}}>
                  <option value="">Escolher classe...</option>
                  {{#each classes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
                </select>
              </label>
              <label>Origem
                <select name="system.originId" {{#unless editable}}disabled{{/unless}}>
                  <option value="">Escolher origem...</option>
                  {{#each origins}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
                </select>
              </label>
              <label>Rank
                <input name="system.rank" value="{{system.rank}}" {{#unless editable}}disabled{{/unless}}>
              </label>
              <label>Respiração
                <input name="system.breathing" value="{{system.breathing}}" placeholder="Ex.: Respiração da Água" {{#unless editable}}disabled{{/unless}}>
              </label>
            </div>
          </section>
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-wind" aria-hidden="true"></i> Respiração</h3>
            {{#if system.breathing}}
              <div class="nas-breath">
                {{#if breathingIcon}}<img src="{{breathingIcon}}" alt="">{{/if}}
                <div><strong>{{system.breathing}}</strong><span class="nas-muted">Formas e estágio entram com o Item de Forma.</span></div>
              </div>
            {{else}}
              <div class="nas-empty"><i class="fa-solid fa-wind" aria-hidden="true"></i><strong>Nenhuma Respiração definida</strong><p>Preencha o campo Respiração em Persona.</p></div>
            {{/if}}
          </section>
        </div>
        <section class="nas-panel">
          <h3 class="nas-panel-title"><i class="fa-solid fa-khanda" aria-hidden="true"></i> Arma equipada</h3>
          <div class="nas-empty nas-empty-row"><i class="fa-solid fa-khanda" aria-hidden="true"></i><div><strong>Nenhuma arma equipada</strong><p>Armas aparecem aqui quando o tipo de Item de arma for criado.</p></div></div>
        </section>
      {{/if}}

      {{#if tabs.combate}}
        <div class="nas-stat-row">
          {{#each combatStats}}
            <div class="nas-stat" data-tooltip="Fórmula pendente"><i class="fa-solid {{icon}}" aria-hidden="true"></i><span>{{label}}</span><strong>—</strong></div>
          {{/each}}
        </div>
        <div class="nas-grid nas-grid-2">
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-khanda" aria-hidden="true"></i> Arma equipada</h3>
            <div class="nas-empty"><i class="fa-solid fa-khanda" aria-hidden="true"></i><strong>Nenhuma arma equipada</strong><p>Dano, alcance e durabilidade vêm do Item de arma.</p></div>
          </section>
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-wind" aria-hidden="true"></i> Estilo / Respiração</h3>
            {{#if system.breathing}}
              <div class="nas-breath">
                {{#if breathingIcon}}<img src="{{breathingIcon}}" alt="">{{/if}}
                <div><strong>{{system.breathing}}</strong><span class="nas-muted">Estágio pendente.</span></div>
              </div>
            {{else}}
              <div class="nas-empty"><i class="fa-solid fa-wind" aria-hidden="true"></i><strong>Nenhuma Respiração definida</strong></div>
            {{/if}}
          </section>
        </div>
        <div class="nas-grid nas-grid-main-side">
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-fire" aria-hidden="true"></i> Técnicas</h3>
            <div class="nas-empty"><i class="fa-solid fa-scroll" aria-hidden="true"></i><strong>Nenhuma técnica registrada</strong><p>Formas de Respiração serão listadas com custo, alcance e dano.</p></div>
          </section>
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Combate rápido</h3>
            <div class="nas-quick">
              {{#each quickActions}}<button type="button" data-action="unfinished"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{label}}</button>{{/each}}
            </div>
          </section>
        </div>
      {{/if}}

      {{#if tabs.testes}}
        <section class="nas-panel">
          <h3 class="nas-panel-title"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i> Testes de atributos</h3>
          <div class="nas-attribute-rail" tabindex="0" aria-label="Testes dos sete atributos">
            {{#each attributes}}
              <button type="button" class="nas-attribute nas-attribute-test" style="--nas-accent:{{color}}" data-action="attribute" data-attribute="{{id}}"><span class="nas-attr-label">{{name}}</span><strong>{{value}}</strong><span class="nas-attr-cta">Testar</span></button>
            {{/each}}
          </div>
        </section>
        <section class="nas-panel">
          <h3 class="nas-panel-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Testes de perícias</h3>
          <div class="nas-skill-grid">
            {{#each skills}}
              <button type="button" class="nas-skill" data-action="unfinished" style="--nas-accent:{{color}}"><span>{{name}}</span><em>{{attrLabel}}</em></button>
            {{/each}}
          </div>
          <p class="nas-muted nas-note">Proficiência e bônus entram com as regras de perícia.</p>
        </section>
      {{/if}}

      {{#if tabs.estados}}
        <section class="nas-panel">
          <h3 class="nas-panel-title"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> Ações do turno</h3>
          <div class="nas-stat-row">
            {{#each actionSlots}}
              <div class="nas-stat" data-tooltip="Contador pendente"><i class="fa-solid {{icon}}" aria-hidden="true"></i><span>{{label}}</span><strong>—</strong></div>
            {{/each}}
          </div>
        </section>
        <div class="nas-grid nas-grid-2">
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-shield" aria-hidden="true"></i> Status e resistências</h3>
            <dl class="nas-readouts">
              <div><dt>Resistências</dt><dd>Não integradas</dd></div>
              <div><dt>Status ativos</dt><dd>Não integrados</dd></div>
              <div><dt>Marca do Caçador</dt><dd>Não integrada</dd></div>
              <div><dt>Armas proficientes</dt><dd>Não integradas</dd></div>
              <div><dt>Estados avançados</dt><dd>Não integrados</dd></div>
            </dl>
          </section>
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-skull" aria-hidden="true"></i> Vida e morte</h3>
            <div class="nas-stat-row nas-stat-row-2">
              <div class="nas-stat" data-tooltip="Regra pendente"><i class="fa-solid fa-skull" aria-hidden="true"></i><span>Marcas de morte</span><strong>— / 3</strong></div>
              <div class="nas-stat" data-tooltip="Regra pendente"><i class="fa-solid fa-person-falling" aria-hidden="true"></i><span>Quedas no combate</span><strong>—</strong></div>
            </div>
          </section>
        </div>
        <div class="nas-grid nas-grid-2">
          <section class="nas-panel nas-panel-danger">
            <h3 class="nas-panel-title"><i class="fa-solid fa-skull-crossbones" aria-hidden="true"></i> Condições negativas</h3>
            <div class="nas-empty"><i class="fa-solid fa-skull-crossbones" aria-hidden="true"></i><p>Nenhuma condição negativa ativa.</p></div>
          </section>
          <section class="nas-panel nas-panel-calm">
            <h3 class="nas-panel-title"><i class="fa-solid fa-spa" aria-hidden="true"></i> Condições positivas</h3>
            <div class="nas-empty"><i class="fa-solid fa-spa" aria-hidden="true"></i><p>Nenhuma condição positiva ativa.</p></div>
          </section>
        </div>
      {{/if}}

      {{#if tabs.inventario}}
        <section class="nas-panel nas-panel-fill">
          <h3 class="nas-panel-title"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i> Inventário <span class="nas-panel-meta">Peso — · Espaços —</span></h3>
          <div class="nas-empty nas-empty-large"><i class="fa-solid fa-box-open" aria-hidden="true"></i><strong>Inventário vazio</strong><p>Armas, equipamentos, consumíveis e materiais entram com os tipos nativos de Item.</p></div>
        </section>
      {{/if}}

      {{#if tabs.diario}}
        <div class="nas-grid nas-grid-2 nas-journal">
          <section class="nas-panel nas-paper">
            <h3 class="nas-panel-title"><i class="fa-solid fa-scroll" aria-hidden="true"></i> Missões ativas</h3>
            <div class="nas-empty"><i class="fa-solid fa-torii-gate" aria-hidden="true"></i><strong>Nenhuma missão registrada</strong><p>O registro de missões da Corporação entra numa próxima etapa.</p></div>
          </section>
          <section class="nas-panel nas-paper">
            <h3 class="nas-panel-title"><i class="fa-solid fa-feather" aria-hidden="true"></i> Anotações do jogador</h3>
            <div class="nas-empty"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i><strong>Caderno em branco</strong><p>Pistas, rumores e anotações terão editor persistente.</p></div>
          </section>
        </div>
      {{/if}}

      {{#if tabs.configuracoes}}
        <div class="nas-grid nas-grid-2">
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-id-card" aria-hidden="true"></i> Informações básicas</h3>
            <dl class="nas-readouts">
              <div><dt>Nome</dt><dd>{{actor.name}}</dd></div>
              <div><dt>Nível</dt><dd>{{system.level}}</dd></div>
              <div><dt>Classe</dt><dd>{{#if className}}{{className}}{{else}}—{{/if}}</dd></div>
              <div><dt>Origem</dt><dd>{{#if originName}}{{originName}}{{else}}—{{/if}}</dd></div>
              <div><dt>Rank</dt><dd>{{system.rank}}</dd></div>
            </dl>
          </section>
          <section class="nas-panel">
            <h3 class="nas-panel-title"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Versão e compatibilidade</h3>
            <dl class="nas-readouts">
              <div><dt>Sistema</dt><dd>Night Assassins {{versions.system}}</dd></div>
              <div><dt>Foundry VTT</dt><dd>{{versions.core}}</dd></div>
            </dl>
            <p class="nas-muted nas-note">Tema, rolagens, módulos e importação/exportação ainda não estão disponíveis.</p>
          </section>
        </div>
      {{/if}}
    </main>
  </div>

  <nav class="nas-navigation" aria-label="Navegação principal da ficha">
    {{#each nav}}
      <button type="button" class="nas-nav-item {{#if active}}is-active{{/if}}" data-action="nav" data-tab="{{id}}" aria-label="{{name}}" aria-current="{{#if active}}page{{else}}false{{/if}}"><span class="nas-nav-icon"><i class="fa-solid {{icon}}" aria-hidden="true"></i></span><span class="nas-nav-text"><span class="nas-nav-label">{{name}}</span><span class="nas-nav-subtitle">{{subtitle}}</span></span></button>
    {{/each}}
  </nav>
</div>
